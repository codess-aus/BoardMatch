# Application environment: local, test, or production.
APP_ENV=local

# Local default. Production must not use SQLite.
DATABASE_URL=sqlite:///./boardmatch.db

# Microsoft Entra / bearer-token authentication.
# Leave blank for local development-header authentication.
AUTH_ISSUER=
AUTH_AUDIENCE=

# Azure OpenAI coaching generation.
# When any of these are blank, BoardMatch falls back to deterministic templates.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Azure Storage account used by production storage/encryption validation.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=documents
STORAGE_ENCRYPTION_REQUIRED=true

# Azure AI Document Intelligence for CV/document text extraction.
# When blank, BoardMatch falls back to deterministic keyword-based extraction.
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# Microsoft Graph OAuth app registration for network sync (integrations).
# When blank, the consent flow and network sync use deterministic
# simulated/fixture data so local development and tests stay offline.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=common
MS_GRAPH_REDIRECT_URI=

# Azure Key Vault URL. When set, production secrets (currently
# AZURE_OPENAI_API_KEY; future database/storage credentials) are loaded from
# Key Vault via DefaultAzureCredential instead of plain environment variables.
# Leave blank for local development. Requires az login, a managed identity,
# or another DefaultAzureCredential-supported auth method.
KEY_VAULT_URL=

# Comma-separated list of allowed CORS origins. Leave blank to disable
# cross-origin requests (recommended default in production).
CORS_ALLOWED_ORIGINS=

# In-process rate limiting for sensitive routes (coaching/AI generation,
# document upload). Requests beyond the limit receive HTTP 429.
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Logging and retention controls.
LOG_LEVEL=INFO
DOCUMENT_RETENTION_DAYS=365
EXTRACTED_TEXT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=90
